#include <windows.h>

#define VER_FILEVERSION             1,4,0,0
#define VER_FILEVERSION_STR         "1.4.0.0\0"

#define VER_PRODUCTVERSION          1,4,0,0
#define VER_PRODUCTVERSION_STR      "1.4.0\0"

#define VER_COMPANYNAME_STR         "DLSSG-Transfusion Team\0"
#define VER_FILEDESCRIPTION_STR     "DLSSG-Transfusion (Universal Blackwell Transfusion & Multi-Game Edition)\0"
#define VER_INTERNALNAME_STR        "@RC_INTERNAL_NAME@\0"
#define VER_LEGALCOPYRIGHT_STR      "Copyright (C) 2026\0"
#define VER_ORIGINALFILENAME_STR    "@RC_ORIGINAL_FILENAME@\0"
#define VER_PRODUCTNAME_STR         "DLSSG-Transfusion\0"
#define VER_COMMENTS_STR            "Universal Blackwell Frame Generation Transfusion for Ada & RTX 40 Series GPUs\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      VER_COMPANYNAME_STR
            VALUE "FileDescription",  VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     VER_INTERNALNAME_STR
            VALUE "LegalCopyright",   VER_LEGALCOPYRIGHT_STR
            VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
            VALUE "ProductName",      VER_PRODUCTNAME_STR
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "Comments",         VER_COMMENTS_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
